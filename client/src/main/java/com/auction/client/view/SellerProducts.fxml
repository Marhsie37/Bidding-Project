<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="746.0" prefWidth="1152.0" style="-fx-background-color: #F1F3F4;"
            xmlns="http://javafx.com/javafx/25"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.SoldProductItemController">
    <children>

        <!-- ══════ TOPBAR ══════ -->
        <AnchorPane layoutX="0.0" layoutY="0.0" prefHeight="50.0" prefWidth="1152.0"
                    style="-fx-background-color: linear-gradient(to right, #c8b8e8, #d8c8f0, #b8a8d8);
                           -fx-effect: dropshadow(gaussian, rgba(160,130,210,0.3), 10, 0, 0, 3);">
            <children>
                <Label layoutX="430.0" layoutY="14.0"
                       style="-fx-font-size: 20px; -fx-font-weight: bold; -fx-text-fill: #3a2060;"
                       text="SẢN PHẨM CỦA TÔI" />

                <Button layoutX="862.0" layoutY="6.0"
                        onAction="#goBack"
                        prefHeight="39.0" prefWidth="130.0"
                        styleClass="btn-seller" stylesheets="@css/Profile.css"
                        text="← Hồ sơ">
                    <font><Font size="15.0" /></font>
                </Button>

                <Button layoutX="1005.0" layoutY="6.0"
                        onAction="#goToLoginScreen"
                        prefHeight="39.0" prefWidth="112.0"
                        styleClass="btn-logout" stylesheets="@css/Profile.css"
                        text="Log out" textAlignment="CENTER" wrapText="true">
                    <font><Font size="15.0" /></font>
                </Button>
            </children>
        </AnchorPane>

        <!-- ══════ TIÊU ĐỀ ══════ -->
        <Label layoutX="111.0" layoutY="62.0"
               style="-fx-font-size: 16px; -fx-font-weight: bold; -fx-text-fill: #5a3ea0;" />

        <!-- ══════ TABPANE SẢN PHẨM ══════ -->
        <TabPane fx:id="tabPaneProducts"
                 layoutX="111.0" layoutY="75.0"
                 prefHeight="640.0" prefWidth="930.0"
                 stylesheets="@css/Admin.css"
                 tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <!-- Tab 1: Đang bán -->
                <Tab text="🛒 Sản phẩm đang bán">
                    <content>
                        <AnchorPane>
                            <children>
                                <!-- Thanh thông tin tổng quan -->
                                <Label fx:id="lblActiveCount"
                                       layoutX="16.0" layoutY="12.0"
                                       style="-fx-font-size: 13px; -fx-text-fill: #5a3ea0; -fx-font-weight: 600;" />

                                <ScrollPane fitToWidth="true"
                                            layoutX="0.0" layoutY="40.0"
                                            prefHeight="580.0" prefWidth="930.0"
                                            stylesheets="@css/Profile.css">
                                    <content>
                                        <VBox fx:id="vBoxActiveProducts"
                                              prefWidth="910.0" spacing="10.0"
                                              style="-fx-padding: 12;" />
                                    </content>
                                </ScrollPane>
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>

                <!-- Tab 2: Đã bán -->
                <Tab text="✅ Sản phẩm đã bán">
                    <content>
                        <AnchorPane>
                            <children>
                                <Label fx:id="lblSoldCount"
                                       layoutX="16.0" layoutY="12.0"
                                       style="-fx-font-size: 13px; -fx-text-fill: #2e7d32; -fx-font-weight: 600;" />

                                <ScrollPane fitToWidth="true"
                                            layoutX="0.0" layoutY="40.0"
                                            prefHeight="580.0" prefWidth="930.0"
                                            stylesheets="@css/Profile.css">
                                    <content>
                                        <VBox fx:id="vBoxSoldProducts"
                                              prefWidth="910.0" spacing="10.0"
                                              style="-fx-padding: 12;" />
                                    </content>
                                </ScrollPane>
                            </children>
                        </AnchorPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>

    </children>
</AnchorPane>
