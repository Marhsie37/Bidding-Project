<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.geometry.Insets?>

<HBox fx:id="rootCard" alignment="CENTER_LEFT" spacing="12.0" 
      styleClass="active-product-card"
      stylesheets="@css/SellerProductItem.css"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" 
      fx:controller="com.auction.client.controller.ActiveProductItemController">
    <padding>
        <Insets bottom="10.0" left="14.0" right="14.0" top="10.0" />
    </padding>
    <children>
        <ImageView fx:id="imgView" fitHeight="60.0" fitWidth="60.0" preserveRatio="true" />
        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
            <children>
                <Label fx:id="lblName" style="-fx-font-weight: bold; -fx-font-size: 14px; -fx-text-fill: #1a1a2e;" text="Tên sản phẩm" />
                <Label fx:id="lblPrice" style="-fx-font-size: 12px; -fx-text-fill: #e07b00; -fx-font-weight: 600;" text="Giá hiện tại: 0 VNĐ" />
                <Label fx:id="lblStart" style="-fx-font-size: 11px; -fx-text-fill: #888888;" text="Giá khởi điểm: 0 VNĐ" />
            </children>
        </VBox>
        <VBox alignment="CENTER_RIGHT" spacing="6.0">
            <children>
                <Label fx:id="lblStatus" style="-fx-background-color: #e8f5e9; -fx-text-fill: #2e7d32; -fx-font-weight: bold; -fx-font-size: 11px; -fx-padding: 4 10 4 10; -fx-background-radius: 20;" text="🟢 Đang đấu giá" />
                <Label fx:id="lblTimer" style="-fx-font-size: 13px; -fx-text-fill: #c62828; -fx-font-weight: bold;" text="00:00" />
            </children>
        </VBox>
    </children>
</HBox>
