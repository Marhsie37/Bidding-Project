<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controller.AuctionChartController" spacing="10"
      stylesheets="@css/AuctionChart.css">

    <LineChart fx:id="auctionLineChart" title="LỊCH SỬ BIẾN ĐỘNG GIÁ" prefHeight="400.0" prefWidth="600.0">
        <xAxis>
            <CategoryAxis label="Thời gian đặt giá" fx:id="xAxis"/>
        </xAxis>
        <yAxis>
            <NumberAxis label="Mức giá (VNĐ)" fx:id="yAxis"/>
        </yAxis>
    </LineChart>

</VBox>