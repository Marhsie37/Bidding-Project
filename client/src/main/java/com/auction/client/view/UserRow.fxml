<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>

<HBox alignment="CENTER_LEFT" prefHeight="50.0" prefWidth="450.0" spacing="10.0" style="-fx-background-color: #f5f5f5; -fx-padding: 10; -fx-background-radius: 8;" xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.UserItemController">
    <children>
        <Label fx:id="lblInfo" prefWidth="280.0" text="User Info" />
        <Region HBox.hgrow="ALWAYS" />
        <Button fx:id="btnBan" prefWidth="60.0" text="Ban" />
        <Button fx:id="btnDelete" prefWidth="60.0" text="Xóa" style="-fx-background-color: #e74c3c; -fx-text-fill: white;" />
    </children>
</HBox>