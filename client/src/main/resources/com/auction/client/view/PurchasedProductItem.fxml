<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Label?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import java.lang.String?>
<VBox alignment="TOP_CENTER" prefHeight="312.0" prefWidth="211.0" spacing="15.0" stylesheets="@css/PurchaseProduct.css"
      xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="com.auction.client.controller.PurchasedProductItemController">
    <children>
        <!-- StackPane cố định chiều cao để tên và giá luôn thẳng hàng dù ảnh kích cỡ khác nhau -->
        <StackPane prefHeight="162.0" minHeight="162.0" maxHeight="162.0" prefWidth="162.0">
            <ImageView fx:id="imgProduct" fitHeight="162.0" fitWidth="162.0" nodeOrientation="INHERIT"
                       preserveRatio="true"/>
        </StackPane>
        <Label fx:id="lblName" style="-fx-font-weight: bold; -fx-font-size: 14;" text="Tên sản phẩm"/>
        <Label fx:id="lblPrice" style="-fx-text-fill: red;" text="Giá"/>
    </children>
    <styleClass>
        <String fx:value="vbox-category-panel"/>
        <String fx:value="product-card"/>
    </styleClass>
</VBox>
