<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<VBox alignment="CENTER" prefHeight="739.0" prefWidth="567.0" spacing="15.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.Profile">
    <children>
        <Label style="-fx-font-size: 20px; -fx-font-weight: bold;" text="THÔNG TIN CÁ NHÂN" />

        <Label text="Tên đăng nhập:" />
        <TextField fx:id="txtUsername" editable="false" prefWidth="300.0" />

        <Label text="Họ tên:" />
        <TextField fx:id="txtFullName" prefWidth="300.0" />

        <Label text="Email:" />
        <TextField fx:id="txtEmail" prefWidth="300.0" />

        <Label text="Số dư (VNĐ):" />
        <TextField fx:id="txtBalance" editable="false" prefWidth="300.0" />

        <Label text="Số tiền muốn nạp:" />
        <TextField fx:id="txtAmount" prefWidth="300.0" promptText="Nhập số tiền" />

        <Button fx:id="btnRecharge" onAction="#handleRecharge" prefWidth="150.0" style="-fx-background-color: #4A90E2; -fx-text-fill: white;" text="NẠP TIỀN" />
        <Button onAction="#goBack" prefWidth="120.0" text="QUAY LẠI" />

        <!-- Thêm TabPane cho sản phẩm đã mua -->
        <TabPane prefHeight="300.0" prefWidth="400.0">
            <tabs>
                <Tab text="Sản phẩm đã mua">
                    <content>
                        <ScrollPane fitToWidth="true">
                            <content>
                                <VBox fx:id="vboxPurchasedProducts" spacing="10.0" />
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>

    </children>
</VBox>
