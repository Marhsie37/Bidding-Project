<?import javafx.scene.control.TextArea?>
<AnchorPane minHeight="0.0" minWidth="0.0" prefHeight="725.0" prefWidth="1148.0" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.auction.client.controller.SellingController">
   <children>
      <AnchorPane layoutY="1.0" minHeight="0.0" minWidth="0.0" prefHeight="726.0" prefWidth="1148.0" style="-fx-background-color: #F4F7F6;">
         <children>
            <VBox layoutX="646.0" layoutY="64.0" prefHeight="580.0" prefWidth="410.0" spacing="15.0" styleClass="vbox-category-panel" stylesheets="@css/Seller.css">
               <children>
                  <VBox prefHeight="162.0" prefWidth="370.0" spacing="5.0">
                     <children>
                        <Label style="-fx-text-fill: #555555; -fx-font-size: 12;" text="Hình ảnh (Tối đa 1 ảnh) *" />
                        <HBox prefHeight="100.0" prefWidth="282.0" spacing="10.0">
                           <children>
                              <AnchorPane fx:id="boxImagePreview" managed="false" prefHeight="100.0" prefWidth="100.0" style="-fx-background-radius: 8; -fx-border-radius: 8; -fx-border-color: #E0E0E0; -fx-border-width: 1;" visible="false">
                                 <children>
                                    <ImageView fx:id="imagePreview" fitHeight="98.0" fitWidth="98.0" layoutX="1.0" layoutY="1.0" pickOnBounds="true" />
                                    <Button layoutX="76.0" layoutY="4.0" mnemonicParsing="false" onAction="#handleRemoveImage" prefHeight="20.0" prefWidth="20.0" style="-fx-background-color: rgba(0,0,0,0.6); -fx-text-fill: white; -fx-background-radius: 50%; -fx-font-size: 10; -fx-padding: 0; -fx-cursor: hand;" text="X" />
                                    <Label alignment="CENTER" layoutX="1.0" layoutY="79.0" prefWidth="98.0" style="-fx-background-color: rgba(142,68,173,0.9); -fx-text-fill: white; -fx-font-size: 11; -fx-font-weight: bold; -fx-background-radius: 0 0 8 8;" text="Ảnh bìa" />
                                 </children>
                              </AnchorPane>
                              <VBox fx:id="boxAddImage" alignment="CENTER" onMouseClicked="#handleChooseImageClick" prefHeight="120.0" prefWidth="370.0" spacing="5.0" style="-fx-border-color: #8E44AD; -fx-border-width: 1.5; -fx-border-radius: 8; -fx-background-color: #F5EEF8; -fx-background-radius: 8; -fx-cursor: hand;" HBox.hgrow="ALWAYS">
                                 <children>
                                    <Label style="-fx-font-size: 28; -fx-text-fill: #8E44AD; -fx-font-weight: bold;" text="+" />
                                    <Label style="-fx-text-fill: #333333; -fx-font-size: 12;" text="Thêm ảnh" />
                                 </children>
                              </VBox>
                           </children>
                        </HBox>
                     </children>
                  </VBox>
                  <AnchorPane prefHeight="138.0" prefWidth="370.0">
                     <children>
                        <VBox layoutX="106.0" minHeight="0.0" minWidth="0.0" prefHeight="164.0" prefWidth="263.0" spacing="25.0">
                           <children>
                              <TextField fx:id="txtName" prefHeight="35.0" prefWidth="192.0" styleClass="text-field-seller" stylesheets="@css/Seller.css" />
                              <TextField fx:id="txtPrice" prefHeight="35.0" prefWidth="192.0" styleClass="text-field-seller" stylesheets="@css/Seller.css" />
                              <TextField fx:id="txtDuration" prefHeight="35.0" prefWidth="192.0" styleClass="text-field-seller" stylesheets="@css/Seller.css" />
                           </children>
                        </VBox>
                        <VBox alignment="CENTER" layoutX="29.0" layoutY="-3.0" minHeight="0.0" minWidth="0.0" prefHeight="164.0" prefWidth="64.0" spacing="44.0">
                           <children>
                              <Label text="Name" />
                              <Label text="Price" />
                              <Label text="Duration" />
                           </children>
                        </VBox>
                     </children>
                  </AnchorPane>
                  <TextArea fx:id="txtDescription" prefHeight="174.0" prefWidth="370.0" promptText="Mô tả sản phẩm ..." styleClass="text-field-seller" stylesheets="@css/Seller.css" wrapText="true" />
               </children>
            </VBox>
            <AnchorPane prefHeight="47.0" prefWidth="1146.0" style="-fx-background-color: #F1EAFF;">
               <children>
                  <Button alignment="TOP_CENTER" layoutX="829.0" layoutY="2.0" mnemonicParsing="false" onAction="#toProfile" prefHeight="39.0" prefWidth="112.0" styleClass="btn-orange-red" stylesheets="@css/Seller.css" text="Profile" />
                  <Button alignment="CENTER" layoutX="959.0" layoutY="2.0" mnemonicParsing="false" nodeOrientation="LEFT_TO_RIGHT" onAction="#goToLoginScreen" prefHeight="39.0" prefWidth="112.0" styleClass="btn-orange-red" stylesheets="@css/Seller.css" text="Log out" textAlignment="CENTER" wrapText="true" AnchorPane.leftAnchor="959.0" />
               </children>
            </AnchorPane>
            <Button layoutX="684.0" layoutY="655.0" mnemonicParsing="false" onAction="#handleAddProduct" prefHeight="39.0" prefWidth="339.0" styleClass="btn-dangky-submit" stylesheets="@css/Seller.css" text="Sell" />
            <ScrollPane fitToWidth="true" layoutX="73.0" layoutY="64.0" prefHeight="579.0" prefWidth="486.0" styleClass="form-container" stylesheets="@css/Seller.css">
               <content>
                  <VBox fx:id="vboxDisplay" prefHeight="682.0" prefWidth="451.0" />
               </content>
            </ScrollPane>
         </children>
      </AnchorPane>
   </children>
</AnchorPane>

