<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.text.Font?>
<AnchorPane prefHeight="746.0" prefWidth="1152.0" style="-fx-background-color: #F1F3F4;"
            xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.auction.client.controller.ProfileSeller">
    <children>
        <VBox alignment="CENTER" layoutY="482.0" prefHeight="257.0" prefWidth="198.0" spacing="15.0">
            <children>

                <!-- Thêm TabPane cho sản phẩm đã mua -->
                <TabPane prefHeight="300.0" prefWidth="400.0"/>

            </children>
        </VBox>
        <AnchorPane layoutX="2.0" prefHeight="34.0" prefWidth="1184.0" style="-fx-background-color: #F1EAFF;"
                    styleClass="topbar" stylesheets="@css/Profile.css">
            <children>
                <Button alignment="CENTER" layoutX="1002.4" layoutY="2.0" mnemonicParsing="false"
                        nodeOrientation="LEFT_TO_RIGHT" onAction="#goToLoginScreen" prefHeight="39.0" prefWidth="112.0"
                        styleClass="btn-logout" stylesheets="@css/Profile.css" text="Log out" textAlignment="CENTER"
                        wrapText="true" AnchorPane.leftAnchor="1002.4">
                    <font>
                        <Font size="17.0"/>
                    </font>
                </Button>
                <Label layoutX="466.0" layoutY="9.0" style="-fx-font-size: 20px; -fx-font-weight: bold;"
                       styleClass="topbar-title" stylesheets="@css/Profile.css" text="THÔNG TIN CÁ NHÂN"/>
                <Button layoutX="862.0" layoutY="3.0" onAction="#goBack" prefHeight="39.0" prefWidth="112.0"
                        styleClass="btn-seller" stylesheets="@css/Profile.css" text="Seller">
                    <font>
                        <Font size="17.0"/>
                    </font>
                </Button>
            </children>
        </AnchorPane>
        <AnchorPane layoutX="313.0" layoutY="79.0" prefHeight="272.0" prefWidth="560.0" styleClass="card"
                    stylesheets="@css/Profile.css">
            <children>
                <HBox layoutX="170.0" layoutY="54.0" prefHeight="134.0" prefWidth="350.0">
                    <children>
                        <VBox alignment="CENTER_LEFT" nodeOrientation="LEFT_TO_RIGHT" prefHeight="200.0"
                              prefWidth="100.0" spacing="34.0">
                            <children>

                                <Label stylesheets="@css/Profile.css" text="Họ tên :"/>

                                <Label text="Email:"/>

                                <Label text="Số dư (VNĐ):"/>
                            </children>
                        </VBox>
                        <VBox prefHeight="134.0" prefWidth="225.0" spacing="15.0">
                            <children>
                                <TextField fx:id="txtFullName" prefHeight="38.0" prefWidth="226.0"
                                           styleClass="field-input" stylesheets="@css/Profile.css"/>
                                <TextField fx:id="txtEmail" prefHeight="38.0" prefWidth="284.0" styleClass="field-input"
                                           stylesheets="@css/Profile.css"/>
                                <TextField fx:id="txtBalance" editable="false" prefHeight="38.0" prefWidth="284.0"
                                           styleClass="field-input-balance" stylesheets="@css/Profile.css"/>
                            </children>
                        </VBox>
                    </children>
                </HBox>
                <Button layoutX="383.0" layoutY="202.0" mnemonicParsing="false" prefHeight="34.0" prefWidth="112.0"
                        styleClass="btn-edit" stylesheets="@css/Profile.css" text="Edit"/>
                <ImageView fitHeight="50.0" fitWidth="42.0" layoutX="47.0" layoutY="94.0" pickOnBounds="true"
                           preserveRatio="true">
                    <image>
                        <Image url="@images/businessman.png"/>
                    </image>
                </ImageView>
                <Label layoutX="44.0" layoutY="144.0" text="Seller">
                    <font>
                        <Font size="20.0"/>
                    </font>
                </Label>
            </children>
        </AnchorPane>
        <TabPane layoutX="313.0" layoutY="373.0" prefHeight="360.0" prefWidth="560.0" styleClass="card"
                 stylesheets="@css/Admin.css" tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="🛒 Sản phẩm đang bán">
                    <content>
                        <ScrollPane fitToWidth="true" prefHeight="310.0" prefWidth="926.0"
                                    stylesheets="@css/Profile.css">
                            <content>
                                <VBox fx:id="vBoxActiveProducts" prefWidth="910.0" spacing="8.0"
                                      style="-fx-padding: 10;"/>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>
                <Tab text="✅ Sản phẩm đã bán">
                    <content>
                        <ScrollPane fitToWidth="true" prefHeight="306.0" prefWidth="873.0"
                                    stylesheets="@css/Profile.css">
                            <content>
                                <VBox fx:id="vBoxSoldProducts" prefWidth="910.0" spacing="8.0"
                                      style="-fx-padding: 10;"/>
                            </content>
                        </ScrollPane>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </children>
</AnchorPane>
